# ==========================================
# YORIPE FRONTEND ENVIRONMENT VARIABLES
# ==========================================
# Copy to '.env' and fill in your actual values.

# Server Settings
PORT=5000
# Database Connections (Neon PostgreSQL & Prisma)
# DATABASE_URL: Pooled connection string (used by Express app runtime via Prisma Client)
DATABASE_URL="postgresql://username:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: Direct connection string (used by Prisma CLI for migrations & schema push)
DIRECT_URL="postgresql://username:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"


# ==========================================
# Copy to '.env' and fill in your actual values.
# ==========================================
# Frontend CORS Configuration
# Local dev: http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Authentication (Clerk)
CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key_here"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key_here"
